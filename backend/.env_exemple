# --- Local (ne change pas) ---
SECRET_KEY=change-moi-plus-tard
DEBUG=True
DB_NAME=red_product_db
DB_USER=postgres
DB_PASSWORD=ton_mot_de_passe
DB_HOST=localhost
DB_PORT=5432

# --- Envoi d'e-mails via Brevo (SMTP) ---
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=ton-login-smtp-brevo
BREVO_SMTP_PASSWORD=ta-cle-smtp-brevo-generee
DEFAULT_FROM_EMAIL=ton-email-verifie@exemple.com

# URL du frontend (utilisée dans le lien de réinitialisation de mot de passe)
FRONTEND_URL=http://localhost:5173

# --- Stockage des images (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=ton-cloud-name
CLOUDINARY_API_KEY=ta-cle-api
CLOUDINARY_API_SECRET=ton-secret-api

# --- Nouveau pour le déploiement (à définir dans le tableau de bord Render,
#     PAS besoin de les mettre dans le .env local — ALLOWED_HOSTS a déjà
#     un défaut correct pour le dev, et DATABASE_URL n'existe qu'en prod) ---
# ALLOWED_HOSTS=mon-backend.onrender.com
